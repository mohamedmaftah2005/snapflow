DATABASE_URL=
REDIS_URL=
# QUEUE_DRIVER=bullmq|local (default: bullmq when REDIS_URL is set, else local)
QUEUE_DRIVER=
# DB_DRIVER=postgres|memory (default: postgres when DATABASE_URL is set, else memory)
DB_DRIVER=
# STORAGE_DRIVER=s3|local (default: s3 when bucket+keys are set, else local)
STORAGE_DRIVER=
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
SIGNED_URL_TTL_SECONDS=900
FILE_TTL_MINUTES=30
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://snapflow.app
# APP_ENV=development|staging|production (selects validation strictness)
APP_ENV=development
# Transactional email sender identity (verify/reset/billing). NOTE: the
# default driver only logs — production MUST wire an SMTP/Resend-backed
# EmailService in src/lib/email.ts before launch (doctor warns).
EMAIL_FROM_ADDRESS=noreply@snapflow.app
MAX_FILE_SIZE=104857600
JOB_TIMEOUT=90000
MAX_CONCURRENT_DOWNLOADS=2
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60000
# Separate budgets so legitimate polling can't starve creation (and vice versa)
RATE_LIMIT_STATUS_REQUESTS=60
RATE_LIMIT_STATUS_WINDOW=60000
RATE_LIMIT_FILE_REQUESTS=30
RATE_LIMIT_FILE_WINDOW=60000
# Honor X-Forwarded-For only behind a trusted proxy that sanitizes it
TRUST_PROXY=false
LOG_LEVEL=info
# Bearer token for GET /api/metrics; unset disables the endpoint (404)
METRICS_TOKEN=
# Optional error-monitoring DSN (integration point, see src/lib/error-monitoring.ts)
SENTRY_DSN=
FAILED_RETENTION_DAYS=7
STALE_TMP_HOURS=24
STALL_TIMEOUT_MS=150000
MAX_REQUEST_BODY_SIZE=8192
MAX_QUEUE_SIZE=100
# Phase 9: batch & archive limits (absolute safety caps; plans only lower them)
FREE_BATCH_LIMIT=3
PREMIUM_BATCH_LIMIT=10
GUEST_BATCH_LIMIT=2
MAX_BATCH_ITEMS=25
MAX_BATCH_ARCHIVE_SIZE=524288000
# Phase 5: client-visible flags use NEXT_PUBLIC_; server flags stay server-side
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Display-only provider list for the UI (backend registry stays authoritative)
NEXT_PUBLIC_PROVIDERS=tiktok
# Provider rollout flags (server-side; YouTube stays off until live-verified)
ENABLE_TIKTOK=true
ENABLE_INSTAGRAM=false
ENABLE_YOUTUBE=false
ENABLE_PREMIUM=false
ENABLE_AUTH=true
ENABLE_CHECKOUT=true
ENABLE_BILLING=true
ENABLE_GUEST_DOWNLOADS=true
# BILLING_PROVIDER=stripe|test (unset = billing disabled)
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
TEST_WEBHOOK_SECRET=test-only-local
# Phase 10: public developer API (see docs/api/quickstart.md)
API_KEY_PEPPER=
WEBHOOK_SECRET_KEY=
WEBHOOK_TIMEOUT_MS=10000
# NEVER enable in production: allows loopback webhook targets (local dev/tests only)
WEBHOOK_ALLOW_PRIVATE=false
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW=60000
ENABLE_NEW_PROVIDER=false
ENABLE_BATCH_DOWNLOAD=false
FILE_TTL_MS=1800000
WORKER_CONCURRENCY=2
# Phase 14: performance, scalability & cost engineering
# BullMQ lock must comfortably exceed worst-case job time (timeout + metadata + upload)
WORKER_LOCK_MS=300000
# Archive worker concurrency (isolated queue so ZIP builds never starve downloads)
ARCHIVE_CONCURRENCY=1
# Per-user in-flight jobs (PENDING/QUEUED/PROCESSING/UPLOADING); fairness cap
MAX_ACTIVE_JOBS_PER_USER=5
# Postgres: shared timeouts + slow-query log threshold (params never logged)
DB_STATEMENT_TIMEOUT_MS=15000
DB_SLOW_QUERY_MS=1000
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Admin aggregate cache TTL (responses carry cachedAt; see docs/caching.md)
ADMIN_STATS_TTL_MS=60000
# Rolling retention for non-financial growth tables (purged in worker sweep)
NOTIFICATION_RETENTION_DAYS=90
EMAIL_LOG_RETENTION_DAYS=90
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
TEMP_DIR=
